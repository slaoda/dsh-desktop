{
  "name": "dsh-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A Windows 11 manager for DeepSeek Harness",
  "license": "MIT",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "desktop",
    "electron"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/run-electron-vite.mjs dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:official": "tsx scripts/smoke-official-dsh.ts",
    "test:packaged": "tsx scripts/e2e-packaged.ts",
    "audit:boundary": "tsx scripts/audit-boundary.ts",
    "release:metadata": "tsx scripts/generate-release-metadata.ts",
    "release:notes": "node scripts/extract-changelog.mjs",
    "version:check": "node scripts/version.mjs check",
    "version:set": "node scripts/version.mjs set",
    "verify": "npm run version:check && npm run typecheck && npm test && npm run build && npm run audit:boundary",
    "prepare:runtime": "tsx scripts/prepare-resources.ts",
    "package:win:x64": "npm run prepare:runtime && npm run build && electron-builder --win --x64 && npm run release:metadata"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "semver": "7.8.5",
    "write-file-atomic": "8.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/semver": "^7.7.1",
    "@types/write-file-atomic": "4.0.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "playwright-core": "1.62.1",
    "pnpm": "11.22.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "dev.dsh.desktop",
    "productName": "DSH Desktop",
    "asar": true,
    "compression": "maximum",
    "publish": null,
    "electronDownload": {
      "checksums": {
        "electron-v43.4.0-win32-x64.zip": "ef0709cfa719739acce73de6f9b684304baf38c6454376638a70d34a7cecffe0"
      },
      "mirrorOptions": {
        "mirror": "https://npmmirror.com/mirrors/electron/"
      }
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "build-resources/runtime",
        "to": "runtime"
      },
      {
        "from": "build-resources/package-manager",
        "to": "package-manager"
      },
      {
        "from": "build-resources/runtime-bin",
        "to": "runtime-bin"
      },
      {
        "from": "build-resources/dsh",
        "to": "dsh"
      },
      {
        "from": "build/menu-version-manager.png",
        "to": "ui/version-manager.png"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis",
      "artifactName": "DSH-Desktop-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false,
      "customNsisBinary": {
        "url": "https://npmmirror.com/mirrors/electron-builder-binaries/nsis-3.0.4.1/nsis-3.0.4.1.7z",
        "version": "3.0.4.1",
        "checksum": "9877df902530f96357d13a7a31ae2b9df67f48b11ffc9a1700a7c961574ec5fa"
      },
      "customNsisResources": {
        "url": "https://npmmirror.com/mirrors/electron-builder-binaries/nsis-resources-3.4.1/nsis-resources-3.4.1.7z",
        "version": "3.4.1",
        "checksum": "593a9a92ef958321293ac6a2ee61e64bf1bd543142a5bd6b3d310709cc924103"
      }
    }
  }
}
